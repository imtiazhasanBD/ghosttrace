# PostgreSQL
POSTGRES_USER=ghosttrace
POSTGRES_PASSWORD=ghosttrace_dev_secret
POSTGRES_DB=ghosttrace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ghosttrace:ghosttrace_dev_secret@localhost:5432/ghosttrace?schema=public

# GhostTrace API & Ingestion
API_PORT=3001
API_URL=http://localhost:3001
JWT_SECRET=ghosttrace_dev_jwt_secret_must_be_very_long_and_secure_key_123456789

# GhostTrace Web Dashboard
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Demo API Service
DEMO_API_PORT=3002
DEMO_DATABASE_URL=postgresql://ghosttrace:ghosttrace_dev_secret@localhost:5432/ghosttrace?schema=public

# OpenTelemetry / GhostTrace SDK Config for Demo API
GHOSTTRACE_ENDPOINT=http://localhost:3001/v1/traces
GHOSTTRACE_API_KEY=gt_live_default_demo_project_key_test_12345
GHOSTTRACE_SERVICE_NAME=demo-api
