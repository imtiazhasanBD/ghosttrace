FROM node:22-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm@12.10.1

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY prisma ./prisma
COPY packages ./packages
COPY apps/api ./apps/api

RUN pnpm install
RUN pnpm --filter @ghosttrace/shared-types run build
RUN pnpm --filter @ghosttrace/prisma run generate
RUN pnpm --filter @ghosttrace/prisma run build
RUN pnpm --filter @ghosttrace/api run build

FROM node:22-alpine AS runner
WORKDIR /app
RUN npm install -g pnpm@12.10.1

COPY --from=builder /app /app

ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001

CMD ["pnpm", "--filter", "@ghosttrace/api", "run", "start:prod"]
